# Copy this file to ".env" and paste your key from https://build.nvidia.com
NVIDIA_API_KEY=
# One key powers every NVIDIA feature. Optional model overrides (defaults shown):
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b          # real-time care agent (tool calling)
# NEMOTRON_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b       # daily care report
# NEMOTRON_ASK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b      # Ask StepCue answers
# NEMOTRON_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning  # spoken check-ins
# NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b             # retrieval
# NEMOTRON_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b           # re-ranking
# NEMOTRON_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# NEMOGUARD_TOPIC_MODEL=nvidia/llama-3.1-nemoguard-8b-topic-control
# RIVA_TRANSLATE_MODEL=nvidia/riva-translate-4b-instruct-v2
# Wearer's language for spoken cues (also settable on the dashboard): en es zh hi fr de pt ja ko ru ar
# STEPCUE_LANG=en
# Extra names to strip from every NVIDIA request (account names are stripped automatically)
# STEPCUE_PRIVATE_NAMES=

# ---- Caregiver alerts (alert_notifier.py). Leave empty to only log alerts. ----
# Free phone push: install the ntfy app and subscribe to this topic. Use a long,
# random topic: anyone who knows it can read messages on the public server.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# Voice call on "please check in" (Twilio trial credit works; trial calls only
# reach numbers you have verified in the Twilio console). Numbers in +1... format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CAREGIVER_PHONE=
# Set to 1 to append the care agent's brief to push messages.
# NOTIFY_INCLUDE_BRIEF=0

# Free Apple Watch heart rate through Apple Shortcuts (see SHORTCUT.md)
STEPCUE_SHORTCUT_URL=
STEPCUE_SHORTCUT_NAME=StepCue
