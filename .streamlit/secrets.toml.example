# Google sign-in for the StepCue dashboard (Streamlit's built-in OIDC).
# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Without this file
# the dashboard falls back to email + password; the authenticator-code step
# is required either way.
#
# 1. https://console.cloud.google.com -> APIs & Services -> OAuth consent screen
#    (External, add yourselves as test users), then Credentials ->
#    Create OAuth client ID -> Web application.
# 2. Authorized redirect URI: http://localhost:8501/oauth2callback
# 3. Paste the client ID and secret below. cookie_secret: any long random string
#    (python -c "import secrets; print(secrets.token_hex(32))").
# 4. Add each person on the dashboard's Access page using their Google email.
#    Google proves who they are; only listed emails get in.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
